# Normalize line endings in the repository to LF; Windows checkouts get CRLF.
* text=auto

# Source and shaders are text. Shaders in particular must never gain a BOM --
# DXC rejects one with a misleading "non-ASCII characters are not allowed".
*.hlsl   text
*.hlsli  text
*.cpp    text
*.hpp    text
*.h      text
*.py     text
*.md     text
*.json   text
*.yml    text

# Windows-only scripts keep CRLF.
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf
